{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run validar:*)",
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Bash(node src/tools/validar-nivel.js:*)",
      "Bash(python3 src/tests/interfaz_e2e.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pip install:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ]
  }
}
